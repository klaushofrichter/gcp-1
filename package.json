{
  "name": "mcp-quotes-server",
  "version": "1.0.0",
  "description": "MCP server that serves quotes from quotes.json",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:http": "node http-server.js",
    "start:mcp-http": "node mcp-server-http.js",
    "start:sse": "node mcp-server-sse.js",
    "start:proxy": "node proxy-server.js",
    "test": "npm run test:core && npm run test:cloudflare",
    "test:core": "jest --testPathPattern='(server|http-server|mcp-server-http|mcp-server-sse|proxy-server)\\.test\\.js$'",
    "test:local": "jest --testPathPattern='(server|http-server|mcp-server-http|mcp-server-sse)\\.test\\.js$'",
    "test:mcp": "jest server.test.js",
    "test:http": "jest http-server.test.js",
    "test:sse": "jest mcp-server-sse.test.js",
    "test:mcp-http": "jest mcp-server-http.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test:core && npm run test:cloudflare",
    "test:cloudflare": "jest --testPathPattern='worker\\.test\\.js$'",
    "test:cloudflare-quick": "./quick-test.sh",
    "test:proxy": "./test-proxy.sh",
    "lint": "eslint .",
    "worker:deploy": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "worker:validate": "npm run test:worker && npm run worker:deploy && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "eventsource": "^4.0.0",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "undici": "^6.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.22.0"
  },
  "jest": {
    "testEnvironment": "node",
    "forceExit": true,
    "detectOpenHandles": false,
    "testTimeout": 10000
  },
  "keywords": [
    "mcp",
    "quotes",
    "server"
  ],
  "author": "",
  "license": "MIT"
}
